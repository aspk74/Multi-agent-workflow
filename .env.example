# ─────────────────────────────────────────────────────────────────────────────
# Autonomous Vendor Negotiation & Risk Matrix — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Your Google AI Studio API key — required for the classifier LLM node.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The Gemini model to use for risk classification.
# Recommended options:
#   gemini-3.5-flash          (fast, cost-efficient, great for structured output)
#   gemini-3.1-pro-preview    (highest capability)
GEMINI_MODEL_NAME=gemini-3.5-flash

# ── Pinecone ──────────────────────────────────────────────────────────────────
# Your Pinecone API key — required for live vector retrieval.
PINECONE_API_KEY=pcsk_...

# The name of your Pinecone index that stores vendor compliance policy embeddings.
PINECONE_INDEX_NAME=vendor-compliance-policies

# ── Application ───────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# The host/port for the FastAPI server (used by uvicorn).
APP_HOST=0.0.0.0
APP_PORT=8000
